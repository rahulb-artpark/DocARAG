# Local Docker Compose defaults. Change the password before any shared or
# network-accessible deployment; compose.yaml binds both databases to loopback.
DOCARAG_POSTGRES_DB=docarag
DOCARAG_POSTGRES_USER=docarag
DOCARAG_POSTGRES_PASSWORD=docarag-local
DOCARAG_POSTGRES_PORT=5432
DOCARAG_DATABASE_URL=postgresql://docarag:docarag-local@127.0.0.1:5432/docarag

DOCARAG_QDRANT_HTTP_PORT=6333
DOCARAG_QDRANT_GRPC_PORT=6334
DOCARAG_QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=use-a-secret-manager-for-non-local-deployments
